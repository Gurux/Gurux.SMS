<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Gurux.SMS.Blazor</PackageId>
    <Version Condition="'$(BUILD_BUILDNUMBER)' == ''">0.0.1-local</Version>
    <Version Condition="'$(BUILD_BUILDNUMBER)' != ''">$(BUILD_BUILDNUMBER)</Version>
    <Authors>Gurux Ltd</Authors><Company>Gurux Ltd</Company>
    <Description>Optional Blazor settings components for Gurux media libraries.</Description>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile></PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <PackageReference Include="Gurux.UI.Components" Version="4.0.2611.1801" />
    <ProjectReference Include="../../Development/Gurux.SMS.csproj" />

    <ProjectReference Include="../../../Gurux.Serial/UI/Gurux.Serial.Blazor/Gurux.Serial.Blazor.csproj" Condition="'$(UsePublishedGuruxPackages)' != 'true'" />
  </ItemGroup>

  <PropertyGroup>
    <RepositoryUrl>https://github.com/Gurux/Gurux.SMS</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>GXSMS.png</PackageIcon>
    <GuruxCommonVersion Condition="'$(GuruxCommonVersion)' == ''">9.0.2611.1802</GuruxCommonVersion>
    <GuruxSerialBlazorVersion Condition="'$(GuruxSerialBlazorVersion)' == ''">9.0.2611.1803</GuruxSerialBlazorVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePublishedGuruxPackages)' == 'true'">
    <PackageReference Include="Gurux.Serial.Blazor" Version="$(GuruxSerialBlazorVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../Development/GXSMS.png" Pack="true" PackagePath="/" />
    <None Remove="Tests/**;tests/**" />
    <Content Remove="Tests/**;tests/**" />
    <EmbeddedResource Remove="Tests/**;tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gurux.Common" Version="$(GuruxCommonVersion)" />
  </ItemGroup>
</Project>
