<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildMobile)' == 'true'">net11.0;net10.0;net11.0-android;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildApple)' == 'true'">net11.0;net10.0;net11.0-android;net10.0-android;net11.0-ios;net10.0-ios</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Gurux/Gurux.SMS</RepositoryUrl>
    <Authors>Gurux Ltd</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>GXSMS.png</PackageIcon>
    <Copyright>Copyright (c) 1998-2026 Gurux Ltd. All rights reserved.</Copyright>
    <PackageId>Gurux.SMS</PackageId>
    <Company>Gurux Ltd</Company>
    <Description>Modern .NET 10 and 11 SMS media with asynchronous transport and optional Android adapters.</Description>
    <Version Condition="'$(BUILD_BUILDNUMBER)' == ''">0.0.1-local</Version>
    <Version Condition="'$(BUILD_BUILDNUMBER)' != ''">$(BUILD_BUILDNUMBER)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GuruxTerminalVersion Condition="'$(GuruxTerminalVersion)' == ''">9.0.2611.1803</GuruxTerminalVersion>
    <GuruxCommonVersion Condition="'$(GuruxCommonVersion)' == ''">9.0.2611.1802</GuruxCommonVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Gurux.Terminal" Version="9.0.2611.1803" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="GXSMS.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties/Resources.resx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gurux.Common" Version="9.0.2611.1802" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="GXSMS.png" LogicalName="Gurux.SMS.MediaIcon.png" />
  </ItemGroup>
</Project>